__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Runtime output, not source
logs/
cache/

# Built by scripts/build-web.mjs at deploy time, from narrator/ui/web/
public/
node_modules/
.vercel/

# The character roster IS committed (~68MB of .vrm/.warudo). They are binaries
# and they are large, but a clone without them cannot put anybody on stage --
# config.toml names these files, so leaving them out makes the checked-in
# config point at nothing. Nothing here exceeds GitHub's 100MB per-file limit
# and they never change, so plain git is fine; LFS would add a quota to manage
# for files that are written once.

# Keep the committed fixture; ignore recordings the operator adds
tests/fixtures/*.csv
!tests/fixtures/xauusd_m1.csv

.vercel
.env*
